# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentra_dev
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentra_test

# Session & Security
# Generate secure random secret for session hashing / CSRF: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-very-long-and-secure-random-secret-key-32-chars-min
SESSION_TTL_HOURS=72
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Google OAuth 2.0 / OpenID Connect
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI Provider Configuration
# AI_PROVIDER options: 'mock' (default for local test/dev), 'gemini', 'openai'
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Agent Execution Limits
AGENT_MAX_ROUNDS=5
AGENT_TOTAL_TIMEOUT_MS=30000
AGENT_TOOL_TIMEOUT_MS=10000
AGENT_MAX_CONTEXT_MESSAGES=20
